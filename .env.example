# --- Deployment tier ---
# development | test | preview | staging | production. Independent of NODE_ENV
# (staging and preview builds still run NODE_ENV=production); stamped on every
# log line so each tier's logs can be told apart. Set it per environment on
# your host (Vercel: Production=production, Preview=preview).
APP_ENV="development"

# --- Database (required) ---
# Postgres connection string. Neon: https://neon.tech → create project → copy the pooled URL.
DATABASE_URL="postgresql://user:password@host:5432/resumerank?sslmode=require"
# Direct (unpooled) URL for migrations. Set it whenever DATABASE_URL goes through
# a transaction-mode pooler (PgBouncer, Neon's -pooler host); on Vercel the app
# logs a warning at startup when it's missing.
# DIRECT_URL="postgresql://user:password@host:5432/resumerank?sslmode=require"
# Connections per app instance (default 3 on Vercel, 10 elsewhere).
# DATABASE_POOL_MAX="3"
# Per-statement cap in ms (default 15000). It is sent as a startup parameter;
# use 0 if your pooler rejects that, and set statement_timeout on the role instead.
# DATABASE_STATEMENT_TIMEOUT_MS="15000"
# Only `prisma migrate diff --from-migrations` needs this: an empty scratch database.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5434/resumerank_shadow"

# --- Integration tests (optional — only `npm run test:integration` reads it) ---
# A disposable database: the suite migrates it and writes/deletes rows. It never
# falls back to DATABASE_URL, so leave this unset unless you have one.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5434/resumerank_test"

# --- Auth (required) ---
# Session signing secret. Generate one: `openssl rand -base64 32` (or `npx auth secret`).
AUTH_SECRET="replace-with-a-32-char-random-secret"
# Canonical app URL. Needed in production (Vercel sets VERCEL_URL, but set this explicitly).
AUTH_URL="http://localhost:3000"

# --- Google OAuth (optional — the Google button hides itself when unset) ---
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI scoring (required for live scoring; seeded demo data works without it) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# --- Email (optional — verification/reset links are logged to the server console when unset) ---
# Delivery picks the first route configured: Resend, then SMTP, then the console.
#
# Route 1 — Resend. Best deliverability, but reaching addresses other than your
# own requires a domain you own, verified at https://resend.com/domains (add the
# DKIM/SPF records it gives you). Without that, the default sandbox EMAIL_FROM
# below only delivers to the address that owns the Resend account.
# Key: https://resend.com/api-keys
RESEND_API_KEY=""

# Route 2 — any SMTP server. Reaches real inboxes with no domain of your own.
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords (your normal password will not work)
# and set EMAIL_FROM to that same Gmail address. Caps at ~500 recipients/day.
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
#   SMTP_USER="you@gmail.com"
#   SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Sender address. Must be on your Resend-verified domain, or match SMTP_USER.
EMAIL_FROM="ResumeRank <onboarding@resend.dev>"

# --- AI budget (optional) ---
# Tokens each company may spend on AI per rolling 30 days. A company row can
# override it (Company.aiTokenBudget) for larger plans.
# AI_TOKEN_BUDGET="5000000"

# --- Client IP (optional) ---
# Rate limits key on the client IP. On Vercel this is automatic. Behind another
# proxy, name the header it overwrites with the real IP (never one a client can
# set), e.g. cf-connecting-ip behind Cloudflare.
# TRUSTED_IP_HEADER="cf-connecting-ip"

# --- Scoring queue (optional) ---
# Scoring runs drain right after they are queued and whenever a recruiter's
# page polls for status. A scheduler hitting GET /api/cron/scoring every minute
# with "Authorization: Bearer $CRON_SECRET" also picks up retries nobody is
# watching (Vercel Cron sends this header automatically). Unset = route off.
# CRON_SECRET="generate-with-openssl-rand-base64-32"

# --- Observability (optional) ---
# Traces go out over OTLP via @vercel/otel. On Vercel, connect an observability
# integration instead; elsewhere point this at any OpenTelemetry collector.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# --- Public ---
# Absolute URL of the deployed app, used for SEO metadata and emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
