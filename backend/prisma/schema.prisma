generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum RequirementWeight {
  MUST
  NICE
}

enum CandidateSource {
  MANUAL
  REFERRAL
  JOB_BOARD
  OUTREACH
  OTHER
}

enum Stage {
  NEW
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum Verdict {
  STRONG
  PARTIAL
  MISSING
}

enum ScoringRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  image          String?
  role           Role      @default(MEMBER)
  notifyByEmail  Boolean   @default(true)
  // Stamped into each session token; bumping it revokes every existing
  // session (password change/reset, removal, "sign out everywhere").
  sessionVersion Int       @default(0)
  companyId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  jobsCreated         Job[]                @relation("JobCreatedBy")
  candidatesCreated   Candidate[]          @relation("CandidateCreatedBy")
  applicationsCreated Application[]        @relation("ApplicationCreatedBy")
  scorecards          Scorecard[]
  activities          ActivityLog[]
  scoringRuns         ScoringRun[]
  invitesSent         CompanyInvite[]      @relation("InvitesSent")

  @@index([companyId])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  website     String?
  description String?
  industry    String?
  size        String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  jobs         Job[]
  candidates   Candidate[]
  applications Application[]
  activities   ActivityLog[]
  invites      CompanyInvite[]
  scoringRuns  ScoringRun[]
}

model CompanyInvite {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId, createdAt(sort: Desc)])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Job {
  id             String         @id @default(cuid())
  title          String
  description    String
  location       String?
  employmentType EmploymentType @default(FULL_TIME)
  status         JobStatus      @default(OPEN)
  companyId      String
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("JobCreatedBy", fields: [createdById], references: [id])
  requirements JobRequirement[]
  applications Application[]

  @@index([companyId, status, createdAt(sort: Desc), id])
  @@index([companyId, title])
}

model JobRequirement {
  id        String            @id @default(cuid())
  jobId     String
  label     String
  weight    RequirementWeight @default(MUST)
  order     Int               @default(0)
  createdAt DateTime          @default(now())

  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]

  @@index([jobId, order])
}

model Candidate {
  id          String          @id @default(cuid())
  name        String
  email       String
  headline    String?
  source      CandidateSource @default(MANUAL)
  resumeText  String
  companyId   String
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("CandidateCreatedBy", fields: [createdById], references: [id])
  applications Application[]

  @@unique([companyId, email])
  @@index([companyId, name])
  @@index([companyId, createdAt(sort: Desc), id])
}

model Application {
  id                 String    @id @default(cuid())
  jobId              String
  candidateId        String
  stage              Stage     @default(NEW)
  // aiScore/aiSummary/scoredAt mirror the latest successful run so lists,
  // sorting and the dashboard never join through the run history.
  aiScore            Int?
  aiSummary          String?
  scoredAt           DateTime?
  latestScoringRunId String?   @unique
  deletedAt          DateTime?
  companyId          String
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate        Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy        User         @relation("ApplicationCreatedBy", fields: [createdById], references: [id])
  latestScoringRun ScoringRun?  @relation("LatestScoringRun", fields: [latestScoringRunId], references: [id], onDelete: SetNull)
  scoringRuns      ScoringRun[] @relation("ApplicationScoringRuns")
  scorecards       Scorecard[]

  @@unique([jobId, candidateId])
  @@index([jobId, deletedAt, stage, aiScore(sort: Desc)])
  @@index([candidateId])
  @@index([companyId, stage, createdAt(sort: Desc), id])
}

/// One per requirement per run. Rows are never updated or deleted on rescore:
/// a new run brings a new set, so every historical score stays explainable.
model Evaluation {
  id            String            @id @default(cuid())
  scoringRunId  String
  requirementId String?
  criterion     String
  weight        RequirementWeight @default(MUST)
  verdict       Verdict
  evidence      String?
  note          String
  createdAt     DateTime          @default(now())

  scoringRun  ScoringRun      @relation(fields: [scoringRunId], references: [id], onDelete: Cascade)
  requirement JobRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([scoringRunId])
}

/// One scoring attempt for an application, and the queue entry that drives
/// it: QUEUED → RUNNING → SUCCEEDED | FAILED, with retryable failures going
/// back to QUEUED until `nextAttemptAt`. Rows are kept after completion as
/// the reproducibility record (model, prompt version, input hash, usage).
model ScoringRun {
  id               String           @id @default(cuid())
  companyId        String
  applicationId    String
  actorId          String?
  status           ScoringRunStatus @default(QUEUED)
  model            String
  promptVersion    String
  temperature      Float
  /// sha256 of everything that shapes the output; equal hashes reuse a result.
  inputHash        String
  attempts         Int              @default(0)
  nextAttemptAt    DateTime         @default(now())
  lockedAt         DateTime?
  finishedAt       DateTime?
  aiScore          Int?
  aiSummary        String?
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  rawOutput        String?
  /// User-safe failure reason, shown on the application page.
  error            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application Application  @relation("ApplicationScoringRuns", fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  latestFor   Application? @relation("LatestScoringRun")
  evaluations Evaluation[]

  @@index([status, nextAttemptAt])
  @@index([companyId, status])
  @@index([applicationId, createdAt(sort: Desc)])
  @@index([companyId, inputHash])
  @@index([actorId])
}

model Scorecard {
  id            String   @id @default(cuid())
  applicationId String
  reviewerId    String
  rating        Int
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([applicationId, reviewerId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  // Nullable so a deleted account is anonymised in the trail rather than
  // erasing the entries it authored.
  actorId    String?
  action     String
  entityType String
  entityId   String
  summary    String
  metadata   Json?
  companyId  String
  createdAt  DateTime @default(now())

  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc), id])
  @@index([actorId])
}
