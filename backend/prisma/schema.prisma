generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum RequirementWeight {
  MUST
  NICE
}

enum CandidateSource {
  MANUAL
  REFERRAL
  JOB_BOARD
  OUTREACH
  OTHER
}

enum Stage {
  NEW
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum Verdict {
  STRONG
  PARTIAL
  MISSING
}

/// Whether an evaluation's quote was found in the resume it was scored against.
enum EvidenceStatus {
  VERIFIED
  UNVERIFIED
  NONE
}

enum ScoringRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum EmailKind {
  VERIFY_EMAIL
  INVITE
  PASSWORD_RESET
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  EXPIRED
  SUPPRESSED
  BOUNCED
  COMPLAINED
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  image          String?
  role           Role      @default(MEMBER)
  notifyByEmail  Boolean   @default(true)
  // Stamped into each session token; bumping it revokes every existing
  // session (password change/reset, removal, "sign out everywhere").
  sessionVersion Int       @default(0)
  companyId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  jobsCreated         Job[]                @relation("JobCreatedBy")
  candidatesCreated   Candidate[]          @relation("CandidateCreatedBy")
  applicationsCreated Application[]        @relation("ApplicationCreatedBy")
  scorecards          Scorecard[]
  activities          ActivityLog[]
  scoringRuns         ScoringRun[]
  invitesSent         CompanyInvite[]      @relation("InvitesSent")

  @@index([companyId])
}

model Company {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  website       String?
  description   String?
  industry      String?
  size          String?
  location      String?
  /// Overrides the default AI token budget (AI_TOKEN_BUDGET) per rolling 30 days.
  aiTokenBudget Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users        User[]
  jobs         Job[]
  candidates   Candidate[]
  applications Application[]
  activities   ActivityLog[]
  invites      CompanyInvite[]
  scoringRuns  ScoringRun[]
}

model CompanyInvite {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([email])
  @@index([invitedById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Job {
  id             String         @id @default(cuid())
  title          String
  description    String
  location       String?
  employmentType EmploymentType @default(FULL_TIME)
  status         JobStatus      @default(OPEN)
  companyId      String
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("JobCreatedBy", fields: [createdById], references: [id])
  requirements JobRequirement[]
  applications Application[]

  // List indexes end in the sort's tie-breaker, scanned in either direction
  // for keyset pagination (see services/keyset.ts).
  @@index([companyId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([companyId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([companyId, title, id])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_title_trgm_idx")
  @@index([createdById])
}

model JobRequirement {
  id        String            @id @default(cuid())
  jobId     String
  label     String
  weight    RequirementWeight @default(MUST)
  order     Int               @default(0)
  createdAt DateTime          @default(now())

  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]

  @@index([jobId, order])
}

model Candidate {
  id          String                   @id @default(cuid())
  name        String
  email       String
  headline    String?
  source      CandidateSource          @default(MANUAL)
  resumeText  String
  /// Full-text index of resumeText, generated by the database; only raw SQL
  /// search reads it (services/candidates.ts).
  resumeTsv   Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, \"resumeText\")"))
  companyId   String
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("CandidateCreatedBy", fields: [createdById], references: [id])
  applications Application[]

  @@unique([companyId, email])
  @@index([companyId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([companyId, name, id])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_email_trgm_idx")
  @@index([headline(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_headline_trgm_idx")
  @@index([resumeTsv], type: Gin)
  @@index([createdById])
}

model Application {
  id                 String    @id @default(cuid())
  jobId              String
  candidateId        String
  stage              Stage     @default(NEW)
  // aiScore/aiSummary/scoredAt mirror the latest successful run so lists,
  // sorting and the dashboard never join through the run history.
  aiScore            Int?
  aiSummary          String?
  scoredAt           DateTime?
  latestScoringRunId String?   @unique
  deletedAt          DateTime?
  companyId          String
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate        Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy        User         @relation("ApplicationCreatedBy", fields: [createdById], references: [id])
  latestScoringRun ScoringRun?  @relation("LatestScoringRun", fields: [latestScoringRunId], references: [id], onDelete: SetNull)
  scoringRuns      ScoringRun[] @relation("ApplicationScoringRuns")
  scorecards       Scorecard[]

  @@unique([jobId, candidateId])
  // The migration declares aiScore NULLS LAST to match the "score" sort;
  // Prisma can't express null ordering in an index.
  @@index([jobId, aiScore(sort: Desc), id(sort: Desc)], where: { deletedAt: null })
  @@index([jobId, createdAt(sort: Desc), id(sort: Desc)], where: { deletedAt: null })
  @@index([companyId, createdAt(sort: Desc), id(sort: Desc)], where: { deletedAt: null })
  @@index([companyId, stage], where: { deletedAt: null })
  @@index([companyId, aiScore], where: { deletedAt: null })
  @@index([candidateId])
  @@index([createdById])
}

/// One per requirement per run. Rows are never updated or deleted on rescore:
/// a new run brings a new set, so every historical score stays explainable.
model Evaluation {
  id             String            @id @default(cuid())
  scoringRunId   String
  requirementId  String?
  criterion      String
  weight         RequirementWeight @default(MUST)
  /// After the evidence rule: STRONG without a verified quote is capped at PARTIAL.
  verdict        Verdict
  /// What the model answered; null on runs scored before the evidence rule.
  modelVerdict   Verdict?
  /// The quote as the model cited it. Only VERIFIED quotes are ever shown.
  evidence       String?
  evidenceStatus EvidenceStatus    @default(NONE)
  note           String
  createdAt      DateTime          @default(now())

  scoringRun  ScoringRun      @relation(fields: [scoringRunId], references: [id], onDelete: Cascade)
  requirement JobRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([scoringRunId])
  @@index([requirementId])
}

/// One scoring attempt for an application, and the queue entry that drives
/// it: QUEUED → RUNNING → SUCCEEDED | FAILED, with retryable failures going
/// back to QUEUED until `nextAttemptAt`. Rows are kept after completion as
/// the reproducibility record (model, prompt version, input hash, usage).
model ScoringRun {
  id               String           @id @default(cuid())
  companyId        String
  applicationId    String
  actorId          String?
  status           ScoringRunStatus @default(QUEUED)
  model            String
  promptVersion    String
  temperature      Float
  seed             Int?
  /// sha256 of everything that shapes the output; equal hashes reuse a result.
  inputHash        String
  attempts         Int              @default(0)
  nextAttemptAt    DateTime         @default(now())
  lockedAt         DateTime?
  finishedAt       DateTime?
  aiScore          Int?
  aiSummary        String?
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  rawOutput        String?
  /// Heuristic prompt-injection signals found in the resume, shown to recruiters.
  injectionSignals String[]         @default([])
  /// User-safe failure reason, shown on the application page.
  error            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application Application  @relation("ApplicationScoringRuns", fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  latestFor   Application? @relation("LatestScoringRun")
  evaluations Evaluation[]

  @@index([status, nextAttemptAt])
  @@index([companyId, status])
  @@index([applicationId, createdAt(sort: Desc)])
  @@index([companyId, inputHash])
  @@index([actorId])
}

model Scorecard {
  id            String   @id @default(cuid())
  applicationId String
  reviewerId    String
  rating        Int
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([applicationId, reviewerId])
  @@index([reviewerId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  // Nullable so a deleted account is anonymised in the trail rather than
  // erasing the entries it authored.
  actorId    String?
  action     String
  entityType String
  entityId   String
  summary    String
  metadata   Json?
  companyId  String
  createdAt  DateTime @default(now())

  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([companyId, entityType, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
}

/// Sliding-window counters shared by every app instance (rate limits, failed
/// logins, AI token usage). One row per key per fixed window; a limit reads
/// the current and the previous window, so rows live for two windows.
model RateLimitCounter {
  key         String
  windowStart DateTime
  count       Int
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

/// Transactional email outbox: rows are written in the same transaction as
/// the token or invite they carry, then delivered by a worker with retries.
model EmailMessage {
  id                String      @id @default(cuid())
  kind              EmailKind
  to                String
  /// AES-256-GCM sealed subject, HTML and action link. The link holds a raw
  /// token, so it is cleared once the message reaches a terminal status.
  payload           String?
  status            EmailStatus @default(QUEUED)
  attempts          Int         @default(0)
  nextAttemptAt     DateTime    @default(now())
  lockedAt          DateTime?
  /// When the link inside stops working; delivering after it is pointless.
  expiresAt         DateTime
  provider          String?
  providerMessageId String?     @unique
  error             String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, nextAttemptAt])
  @@index([to, createdAt(sort: Desc)])
  @@index([createdAt])
}

/// Addresses that hard-bounced or complained; the outbox never mails them again.
model EmailSuppression {
  email     String   @id
  reason    String
  createdAt DateTime @default(now())
}
