generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

/// MEMBER is the recruiter. HIRING_MANAGER and INTERVIEWER only reach the
/// jobs they're assigned to, directly or through a department (services/access.ts).
enum Role {
  OWNER
  ADMIN
  MEMBER
  HIRING_MANAGER
  INTERVIEWER
  VIEWER
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum RequirementWeight {
  MUST
  NICE
}

enum CandidateSource {
  MANUAL
  REFERRAL
  JOB_BOARD
  OUTREACH
  OTHER
}

enum Stage {
  NEW
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum Verdict {
  STRONG
  PARTIAL
  MISSING
}

/// Whether an evaluation's quote was found in the resume it was scored against.
enum EvidenceStatus {
  VERIFIED
  UNVERIFIED
  NONE
}

enum ScoringRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ResumeFileStatus {
  QUEUED
  RUNNING
  PARSED
  FAILED
}

enum ResumeFileKind {
  PDF
  DOCX
}

/// How a resume file's text was read: its own text layer, or OCR of the rendered pages.
enum ResumeExtraction {
  TEXT
  OCR
}

/// What a stored WebAuthn challenge was issued for; each is single-use.
enum WebAuthnCeremony {
  REGISTRATION
  AUTHENTICATION
}

/// How a session signed in.
enum SignInMethod {
  PASSWORD
  GOOGLE
  SSO
}

/// Where an audit stream delivers: a signed HTTPS webhook, a Splunk HTTP
/// Event Collector, or the Datadog logs intake.
enum AuditStreamKind {
  WEBHOOK
  SPLUNK
  DATADOG
}

enum Plan {
  FREE
  TEAM
  ENTERPRISE
}

/// Mirrors Stripe's subscription statuses.
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  UNPAID
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

enum EmailKind {
  VERIFY_EMAIL
  INVITE
  PASSWORD_RESET
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  EXPIRED
  SUPPRESSED
  BOUNCED
  COMPLAINED
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  emailVerified   DateTime?
  passwordHash    String?
  image           String?
  /// Deprecated: the role in the `companyId` workspace, mirrored from its
  /// Membership by a trigger for code deployed before memberships. Read
  /// Membership.role instead.
  role            Role      @default(MEMBER)
  notifyByEmail   Boolean   @default(true)
  // Stamped into each session token; bumping it revokes every existing
  // session (password change/reset, removal, "sign out everywhere"). Each
  // sign-in's LoginSession row is revoked alongside, so the sessions list
  // agrees with what the guards enforce.
  sessionVersion  Int       @default(0)
  /// Deprecated: superseded by Membership.directoryUserId, which a directory
  /// sets per workspace. No longer written.
  directoryUserId String?
  /// When the user's first second factor was confirmed; null while they have
  /// none. Sessions record the value they verified against, so turning MFA
  /// off and on again (or an admin reset) asks every session to verify anew.
  mfaEnabledAt    DateTime?
  /// The workspace a new sign-in opens in: the one last switched to. Always
  /// one the user is a member of (the Membership triggers keep it so), or null.
  companyId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  memberships         Membership[]
  accounts            Account[]
  sessions            Session[]
  loginSessions       LoginSession[]
  passwordResetTokens PasswordResetToken[]
  jobsCreated         Job[]                @relation("JobCreatedBy")
  candidatesCreated   Candidate[]          @relation("CandidateCreatedBy")
  applicationsCreated Application[]        @relation("ApplicationCreatedBy")
  scorecards          Scorecard[]
  activities          ActivityLog[]
  scoringRuns         ScoringRun[]
  resumeFilesUploaded ResumeFile[]
  invitesSent         CompanyInvite[]      @relation("InvitesSent")
  totpFactor          TotpFactor?
  webAuthnCredentials WebAuthnCredential[]
  webAuthnChallenges  WebAuthnChallenge[]
  mfaRecoveryCodes    MfaRecoveryCode[]

  @@unique([companyId, directoryUserId])
  @@index([companyId])
}

/// A person's place in a workspace. One account can belong to several
/// companies (agencies, consultants, subsidiaries), with a role in each.
model Membership {
  id              String   @id @default(cuid())
  userId          String
  companyId       String
  role            Role     @default(MEMBER)
  /// The id this company's SCIM directory knows the person by; set while the
  /// directory manages this membership, so renames follow the right person.
  directoryUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobAssignments    JobAssignment[]
  departmentMembers DepartmentMember[]
  apiKeys           ApiKey[]

  @@unique([userId, companyId])
  @@unique([companyId, directoryUserId])
  @@index([companyId, role])
}

model Company {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  logoUrl                String?
  website                String?
  description            String?
  industry               String?
  size                   String?
  location               String?
  /// Overrides the default AI token budget (AI_TOKEN_BUDGET) per rolling 30 days.
  aiTokenBudget          Int?
  /// Members must sign in through the company's SSO connection. Owners keep
  /// their password as the way back in if the identity provider breaks.
  ssoEnforced            Boolean  @default(false)
  /// Members must have a second factor before they can use the workspace.
  /// Single sign-on sessions are exempt: the identity provider owns MFA there.
  mfaRequired            Boolean  @default(false)
  /// Sessions end this long after signing in, however active they are.
  sessionLifetimeMinutes Int      @default(43200)
  /// Sessions end after this long without a request.
  sessionIdleMinutes     Int      @default(10080)
  /// Shortest password a member may set. Accounts span workspaces, so the
  /// strictest policy among a person's workspaces applies (auth/password-policy.ts).
  passwordMinLength      Int      @default(8)
  /// Refuse passwords found in known breaches (Have I Been Pwned, k-anonymity).
  passwordBreachCheck    Boolean  @default(false)
  /// Audit entries older than this are deleted; null keeps them forever.
  auditRetentionDays     Int?
  /// Names, contact details and protected attributes are masked in resume
  /// text before it reaches the model (scoring/redact.ts).
  aiRedactPii            Boolean  @default(false)
  /// Scoring refuses candidates who haven't been given the AI notice.
  aiNoticeRequired       Boolean  @default(false)
  /// Candidates with no activity for this long are deleted with everything
  /// about them (retention/candidates.ts); null keeps them until deleted by hand.
  candidateRetentionDays Int?
  /// The company's own notice wording; null shows the default
  /// (frontend/src/app/(marketing)/ai-notice).
  aiNoticeText           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  users            User[]
  memberships      Membership[]
  loginSessions    LoginSession[]        @relation("LoginSessionCompany")
  ssoLoginSessions LoginSession[]        @relation("LoginSessionSso")
  jobs             Job[]
  departments      Department[]
  candidates       Candidate[]
  applications     Application[]
  activities       ActivityLog[]
  invites          CompanyInvite[]
  scoringRuns      ScoringRun[]
  domains          CompanyDomain[]
  auditStream      AuditStream?
  featureOverrides FeatureFlagOverride[]
  webhookEndpoints WebhookEndpoint[]
  resumeFiles      ResumeFile[]
  billingAccount   BillingAccount?
  ipAllowlist      IpAllowlistEntry[]
  selfIdResponses  SelfIdResponse[]
}

/// An email domain a company claims. A DNS TXT record proves control; only a
/// verified domain routes SSO sign-ins to the company or lets its identity
/// provider vouch for an address.
model CompanyDomain {
  id                String    @id @default(cuid())
  companyId         String
  domain            String
  verificationToken String
  verifiedAt        DateTime?
  /// People who sign in through the company's SSO with this domain join as
  /// members without an invite.
  autoJoin          Boolean   @default(false)
  createdAt         DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, domain])
  // Any company may claim a domain, but only one can verify it.
  @@unique([domain], map: "CompanyDomain_verified_domain_key", where: raw("\"verifiedAt\" IS NOT NULL"))
}

/// A network members may use the workspace from. With none, any network will
/// do; with some, every request from elsewhere is refused (owners excepted).
model IpAllowlistEntry {
  id        String   @id @default(cuid())
  companyId String
  /// Canonical CIDR (`auth/ip-allowlist.ts`), so the same range can't be added twice.
  cidr      String
  label     String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, cidr])
}

model CompanyInvite {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([email])
  @@index([invitedById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One sign-in. Its id is the session token's `loginId`. The guards end the
/// session once this row is revoked, has gone idle, or is older than the
/// company allows, so revoking takes effect on the next request. Auth.js's
/// own `Session` model stays unused under the JWT strategy.
model LoginSession {
  id                     String       @id
  userId                 String
  method                 SignInMethod
  userAgent              String?
  ipAddress              String?
  createdAt              DateTime     @default(now())
  /// Written at most once a minute (see auth/session-policy.ts).
  lastSeenAt             DateTime     @default(now())
  revokedAt              DateTime?
  /// The workspace this sign-in has open. Each sign-in switches on its own, so
  /// a laptop and a phone can have different companies open.
  companyId              String?
  /// The company whose identity provider vouched for this sign-in. Only that
  /// company's single sign-on requirement is met by it.
  ssoCompanyId           String?
  /// The password this sign-in used falls short of the current policy; the
  /// guards hold the session at /password-change until it sets a new one.
  passwordChangeRequired Boolean      @default(false)
  /// When this sign-in last re-proved who it is (step-up). Sensitive actions
  /// need this or the sign-in itself to be recent (auth/step-up.ts).
  reauthenticatedAt      DateTime?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company? @relation("LoginSessionCompany", fields: [companyId], references: [id], onDelete: SetNull)
  ssoCompany Company? @relation("LoginSessionSso", fields: [ssoCompanyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([companyId])
}

/// An authenticator-app secret. Unconfirmed until the user enters a code from
/// it, and only a confirmed one counts as a factor.
model TotpFactor {
  userId       String    @id
  /// The shared secret, AES-256-GCM sealed (see auth/mfa/secrets.ts).
  secret       String
  confirmedAt  DateTime?
  /// The newest time step a code was accepted for, so each code works once.
  lastUsedStep Int?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A passkey or security key registered as a second factor.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  /// The authenticator's credential id, base64url.
  credentialId String    @unique
  publicKey    Bytes
  /// The signature counter is a uint32, which overflows Int.
  counter      BigInt    @default(0)
  transports   String[]
  name         String
  /// Synced across the user's devices (a passkey) rather than bound to one.
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// The challenge of an in-flight WebAuthn ceremony, consumed by its response.
model WebAuthnChallenge {
  userId    String
  ceremony  WebAuthnCeremony
  challenge String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, ceremony])
}

/// A one-time code for signing in without a second factor at hand.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the normalised code; the codes carry 80 bits of entropy.
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Job {
  id             String         @id @default(cuid())
  title          String
  description    String
  location       String?
  employmentType EmploymentType @default(FULL_TIME)
  status         JobStatus      @default(OPEN)
  departmentId   String?
  companyId      String
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("JobCreatedBy", fields: [createdById], references: [id])
  requirements JobRequirement[]
  applications Application[]
  assignments  JobAssignment[]

  // List indexes end in the sort's tie-breaker, scanned in either direction
  // for keyset pagination (see services/keyset.ts).
  @@index([companyId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([companyId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([companyId, title, id])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_title_trgm_idx")
  @@index([createdById])
  @@index([departmentId])
}

/// A team of people who see every job filed under it, so a hiring manager
/// doesn't need adding to each new opening by hand.
model Department {
  id        String   @id @default(cuid())
  name      String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs    Job[]
  members DepartmentMember[]

  @@unique([companyId, name])
}

/// Keyed on the membership, so leaving the workspace ends the access with it.
model DepartmentMember {
  id           String   @id @default(cuid())
  departmentId String
  userId       String
  companyId    String
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([companyId, userId])
}

/// The hiring team on one job. Keyed on the membership, so leaving the
/// workspace ends the access with it.
model JobAssignment {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  companyId String
  createdAt DateTime @default(now())

  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([companyId, userId])
}

model JobRequirement {
  id        String            @id @default(cuid())
  jobId     String
  label     String
  weight    RequirementWeight @default(MUST)
  order     Int               @default(0)
  createdAt DateTime          @default(now())

  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]

  @@index([jobId, order])
}

model Candidate {
  id          String                   @id @default(cuid())
  name        String
  email       String
  headline    String?
  source      CandidateSource          @default(MANUAL)
  resumeText  String
  /// When the candidate was told AI helps screen applications (NYC LL144, EU AI Act Art. 26).
  aiNoticeAt  DateTime?
  /// Set when the candidate asked not to be scored by AI; scoring refuses them.
  aiOptOutAt  DateTime?
  /// Full-text index of resumeText, generated by the database; only raw SQL
  /// search reads it (services/candidates.ts).
  resumeTsv   Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, \"resumeText\")"))
  companyId   String
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("CandidateCreatedBy", fields: [createdById], references: [id])
  applications Application[]
  resumeFiles  ResumeFile[]

  @@unique([companyId, email])
  @@index([companyId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([companyId, name, id])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_email_trgm_idx")
  @@index([headline(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_headline_trgm_idx")
  @@index([resumeTsv], type: Gin)
  @@index([createdById])
}

/// An uploaded resume file. The original stays in blob storage for audit;
/// parsing it is queued, and its text becomes the candidate's resume text.
model ResumeFile {
  id             String            @id
  companyId      String
  candidateId    String
  uploadedById   String?
  /// Always `<companyId>/resumes/<id>.<ext>`, never built from client input.
  blobKey        String            @unique
  /// The uploader's file name, cleaned, for display and download only.
  fileName       String
  kind           ResumeFileKind
  sizeBytes      Int
  /// sha256 of the original, so an audit can show the stored file is the uploaded one.
  sha256         String
  status         ResumeFileStatus  @default(QUEUED)
  attempts       Int               @default(0)
  nextAttemptAt  DateTime          @default(now())
  lockedAt       DateTime?
  finishedAt     DateTime?
  extraction     ResumeExtraction?
  extractedChars Int?
  /// User-safe failure reason, shown on the candidate page.
  error          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate  Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([companyId, candidateId, createdAt(sort: Desc)])
  @@index([candidateId])
  @@index([uploadedById])
}

model Application {
  id                 String    @id @default(cuid())
  jobId              String
  candidateId        String
  stage              Stage     @default(NEW)
  // aiScore/aiSummary/scoredAt mirror the latest successful run so lists,
  // sorting and the dashboard never join through the run history.
  aiScore            Int?
  aiSummary          String?
  scoredAt           DateTime?
  latestScoringRunId String?   @unique
  deletedAt          DateTime?
  companyId          String
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job              Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate        Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy        User            @relation("ApplicationCreatedBy", fields: [createdById], references: [id])
  latestScoringRun ScoringRun?     @relation("LatestScoringRun", fields: [latestScoringRunId], references: [id], onDelete: SetNull)
  scoringRuns      ScoringRun[]    @relation("ApplicationScoringRuns")
  scorecards       Scorecard[]
  selfId           SelfIdResponse?

  @@unique([jobId, candidateId])
  // The migration declares aiScore NULLS LAST to match the "score" sort;
  // Prisma can't express null ordering in an index.
  @@index([jobId, aiScore(sort: Desc), id(sort: Desc)], where: { deletedAt: null })
  @@index([jobId, createdAt(sort: Desc), id(sort: Desc)], where: { deletedAt: null })
  @@index([companyId, createdAt(sort: Desc), id(sort: Desc)], where: { deletedAt: null })
  @@index([companyId, stage], where: { deletedAt: null })
  @@index([companyId, aiScore], where: { deletedAt: null })
  @@index([candidateId])
  @@index([createdById])
}

/// One per requirement per run. Rows are never updated or deleted on rescore:
/// a new run brings a new set, so every historical score stays explainable.
model Evaluation {
  id             String            @id @default(cuid())
  scoringRunId   String
  requirementId  String?
  criterion      String
  weight         RequirementWeight @default(MUST)
  /// After the evidence rule: STRONG without a verified quote is capped at PARTIAL.
  verdict        Verdict
  /// What the model answered; null on runs scored before the evidence rule.
  modelVerdict   Verdict?
  /// The quote as the model cited it. Only VERIFIED quotes are ever shown.
  evidence       String?
  evidenceStatus EvidenceStatus    @default(NONE)
  note           String
  createdAt      DateTime          @default(now())

  scoringRun  ScoringRun      @relation(fields: [scoringRunId], references: [id], onDelete: Cascade)
  requirement JobRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([scoringRunId])
  @@index([requirementId])
}

/// One scoring attempt for an application, and the queue entry that drives
/// it: QUEUED → RUNNING → SUCCEEDED | FAILED, with retryable failures going
/// back to QUEUED until `nextAttemptAt`. Rows are kept after completion as
/// the reproducibility record (model, prompt version, input hash, usage).
model ScoringRun {
  id               String           @id @default(cuid())
  companyId        String
  applicationId    String
  actorId          String?
  status           ScoringRunStatus @default(QUEUED)
  model            String
  promptVersion    String
  temperature      Float
  seed             Int?
  /// sha256 of everything that shapes the output; equal hashes reuse a result.
  inputHash        String
  attempts         Int              @default(0)
  nextAttemptAt    DateTime         @default(now())
  lockedAt         DateTime?
  finishedAt       DateTime?
  aiScore          Int?
  aiSummary        String?
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  rawOutput        String?
  /// Heuristic prompt-injection signals found in the resume, shown to recruiters.
  injectionSignals String[]         @default([])
  /// User-safe failure reason, shown on the application page.
  error            String?
  /// Exactly what the model was given (ScoringInput), so the run can be
  /// reproduced and explained later however the job or resume changed.
  input            Json?
  /// The resume text was redacted before scoring (Company.aiRedactPii).
  redacted         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application Application  @relation("ApplicationScoringRuns", fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  latestFor   Application? @relation("LatestScoringRun")
  evaluations Evaluation[]

  @@index([status, nextAttemptAt])
  @@index([companyId, status])
  @@index([companyId, finishedAt])
  @@index([applicationId, createdAt(sort: Desc)])
  @@index([companyId, inputHash])
  @@index([actorId])
}

model Scorecard {
  id            String   @id @default(cuid())
  applicationId String
  reviewerId    String
  rating        Int
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([applicationId, reviewerId])
  @@index([reviewerId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  // Nullable so a deleted account is anonymised in the trail rather than
  // erasing the entries it authored.
  actorId    String?
  action     String
  entityType String
  entityId   String
  summary    String
  metadata   Json?
  companyId  String
  createdAt  DateTime @default(now())
  /// The entry's place in its company's hash chain, and the chain links. All
  /// three are set by the audit_seal trigger as the inserting transaction
  /// commits, so they are null only inside that transaction.
  seq        BigInt?
  prevHash   String?
  hash       String?

  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, seq])
  @@index([companyId, entityType, entityId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([companyId, entityType, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
}

/// A company's live feed of audit entries to its SIEM. Delivery walks the
/// hash chain by `seq`, so `cursorSeq` alone says what has been delivered.
model AuditStream {
  id              String          @id @default(cuid())
  companyId       String          @unique
  kind            AuditStreamKind
  url             String
  /// Sealed: the webhook signing secret, or the Splunk / Datadog token.
  secret          String
  enabled         Boolean         @default(true)
  cursorSeq       BigInt          @default(0)
  failures        Int             @default(0)
  nextAttemptAt   DateTime        @default(now())
  lockedAt        DateTime?
  lastDeliveredAt DateTime?
  lastError       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([enabled, nextAttemptAt])
}

/// Staff's per-company setting for one feature flag (`backend/src/flags`),
/// written only by the flags CLI. It beats the flag's rollout and default, so
/// it both rolls a feature out to one tenant early and holds one back.
model FeatureFlagOverride {
  id        String   @id @default(cuid())
  companyId String
  /// A key of `FLAGS`. Rows for a flag that has since been removed are ignored.
  flag      String
  enabled   Boolean
  /// Why staff set it, for whoever finds it later.
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, flag])
}

/// A token for the public REST API. It acts as the admin who created it,
/// with their current role narrowed by `scopes`, and rides their membership:
/// leaving the workspace deletes it. Only a hash of the secret is stored.
model ApiKey {
  id          String    @id @default(cuid())
  companyId   String
  createdById String
  name        String
  /// The token's first characters, shown so people can tell keys apart.
  prefix      String
  secretHash  String
  scopes      String[]
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  membership Membership @relation(fields: [createdById, companyId], references: [userId, companyId], onDelete: Cascade)

  @@index([companyId, createdAt])
}

/// A customer URL that receives signed event notifications.
model WebhookEndpoint {
  id              String    @id @default(cuid())
  companyId       String
  url             String
  /// Sealed signing secret, bound to the company and URL.
  secret          String
  events          String[]
  enabled         Boolean   @default(true)
  lastDeliveredAt DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([companyId])
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

/// The outbox: one row per event per endpoint, written in the transaction
/// that caused the event, delivered at least once with backoff.
model WebhookDelivery {
  id            String                @id @default(cuid())
  companyId     String
  endpointId    String
  event         String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now())
  lockedAt      DateTime?
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

/// A company's plan and its Stripe subscription, kept in step by Stripe's
/// webhooks. No row means the Free plan. Tenants may only attach a Stripe
/// customer; everything else is written by the webhook (column grants in the
/// migration), so no app path can hand a workspace a plan it didn't pay for.
model BillingAccount {
  id                   String              @id @default(cuid())
  companyId            String              @unique
  plan                 Plan                @default(FREE)
  /// Null until a subscription exists.
  status               SubscriptionStatus?
  /// Paid seats (the subscription quantity); null on Free and comped plans.
  seats                Int?
  /// Granted without a subscription: workspaces from before billing.
  comped               Boolean             @default(false)
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean             @default(false)
  /// When the first unpaid invoice made it past due; the grace period runs from here.
  pastDueSince         DateTime?
  /// Scoring runs that finished up to here have been sent to the Stripe usage
  /// meter. Set when the first paid subscription starts, so earlier usage is
  /// never metered.
  meteredThrough       DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// Stripe events already applied. Stripe delivers at least once, so the
/// webhook records each id in the transaction that applies it.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// Sliding-window counters shared by every app instance (rate limits, failed
/// logins, AI token usage). One row per key per fixed window; a limit reads
/// the current and the previous window, so rows live for two windows.
model RateLimitCounter {
  key         String
  windowStart DateTime
  count       Int
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

/// Transactional email outbox: rows are written in the same transaction as
/// the token or invite they carry, then delivered by a worker with retries.
model EmailMessage {
  id                String      @id @default(cuid())
  kind              EmailKind
  to                String
  /// AES-256-GCM sealed subject, HTML and action link. The link holds a raw
  /// token, so it is cleared once the message reaches a terminal status.
  payload           String?
  status            EmailStatus @default(QUEUED)
  attempts          Int         @default(0)
  nextAttemptAt     DateTime    @default(now())
  lockedAt          DateTime?
  /// When the link inside stops working; delivering after it is pointless.
  expiresAt         DateTime
  provider          String?
  providerMessageId String?     @unique
  error             String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, nextAttemptAt])
  @@index([to, createdAt(sort: Desc)])
  @@index([createdAt])
}

/// Addresses that hard-bounced or complained; the outbox never mails them again.
model EmailSuppression {
  email     String   @id
  reason    String
  createdAt DateTime @default(now())
}

/// Key-value records for the embedded SSO service (SAML/OIDC connections,
/// in-flight logins, its signing certificate). Values arrive already
/// encrypted with SSO_ENCRYPTION_KEY; see backend/src/sso/store.ts.
model SsoRecord {
  key        String    @id
  namespace  String
  value      String
  iv         String?
  tag        String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  modifiedAt DateTime  @updatedAt

  indexes SsoRecordIndex[]

  @@index([namespace, createdAt(sort: Desc)])
  @@index([expiresAt])
}

/// Secondary lookups (e.g. connections by tenant) into SsoRecord.
model SsoRecordIndex {
  id        String @id @default(cuid())
  key       String
  recordKey String

  record SsoRecord @relation(fields: [recordKey], references: [key], onDelete: Cascade)

  @@unique([key, recordKey])
  @@index([recordKey])
}

/// EEO-1 categories, for bias audits only.
enum SelfIdSex {
  FEMALE
  MALE
}

enum SelfIdRace {
  HISPANIC_OR_LATINO
  WHITE
  BLACK_OR_AFRICAN_AMERICAN
  NATIVE_HAWAIIAN_OR_PACIFIC_ISLANDER
  ASIAN
  AMERICAN_INDIAN_OR_ALASKA_NATIVE
  TWO_OR_MORE_RACES
}

/// A candidate's voluntary self-identification for one application, given
/// through a signed link. Kept apart from everything scoring reads, and only
/// ever reported in aggregate (services/fairness.ts). Null means "prefer not to say".
model SelfIdResponse {
  id            String      @id @default(cuid())
  companyId     String
  applicationId String      @unique
  sex           SelfIdSex?
  race          SelfIdRace?
  submittedAt   DateTime    @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([companyId])
}
